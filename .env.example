# Contact form delivery (spec §8.3) — https://resend.com
#
# CONTACT_FROM must be on a domain VERIFIED in Resend. This is not optional:
# with an unverified sender, Resend only permits delivery to the account
# owner's own address and rejects everything else, so the form returns 502.
#
# `epaseroadmin.com` is already verified on the Epasero Resend account, so
# website@epaseroadmin.com works today with no DNS changes. Verified by a live
# send to contact@epaserocontracting.com.
#
# Only switch this to @epaserocontracting.com after verifying that domain in
# Resend — otherwise the form silently regresses to 502.
RESEND_API_KEY=
CONTACT_FROM=website@epaseroadmin.com

# Google Reviews for the Client Stories section (spec §4.7).
# Create the key in Google Cloud with the "Places API (New)" enabled, and
# restrict it to your server. NEVER prefix these with NEXT_PUBLIC_ — that would
# ship the key to the browser and let anyone bill your account.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Content Studio (the editing dashboard at /studio).
# Without these the site still works - it serves the content in data/ instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=bbec9q7g
NEXT_PUBLIC_SANITY_DATASET=production
